<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fold_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.example.gsyvideoplayer.video.LandLayoutVideo
        android:id="@+id/fold_player"
        android:layout_width="match_parent"
        android:layout_height="@dimen/post_media_height" />

    <View
        android:id="@+id/fold_divider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FF202020"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fold_info_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/fold_posture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="展开态"
                android:textColor="#FF6200EE"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="折叠屏适配 Demo（XML）"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fold_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/detail_text"
                android:textSize="16sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
